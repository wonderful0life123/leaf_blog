# Copy to /etc/wonder-studio.env on the server; chmod 600. Never commit real secrets.
WONDER_STUDIO_ORIGIN=https://wonder-ai.info
WONDER_STUDIO_PORT=4312
WONDER_GITHUB_OWNER_ID=222740128
WONDER_GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
WONDER_GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
WONDER_STUDIO_DATA_DIR=/var/lib/wonder-studio
WONDER_STUDIO_WEB_DIR=/opt/wonder-studio/studio-dist
WONDER_STUDIO_POSTS_DIR=/srv/wonder-sources/leaf_blog/src/content/posts
WONDER_STUDIO_NOTES_DIR=/srv/wonder-sources/obsidian_note
# Do not set WONDER_STUDIO_LOCAL or WONDER_STUDIO_DEV_HTTP in production.
